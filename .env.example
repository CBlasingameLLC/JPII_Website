# Stripe — https://dashboard.stripe.com/apikeys (use test mode keys for local dev)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Used to build absolute success/cancel URLs for Stripe Checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Printful — https://developers.printful.com (Store > API keys)
PRINTFUL_API_KEY=...
PRINTFUL_STORE_ID=...

# New-student signups. A Google Apps Script web-app URL bound to the ministry's
# signup spreadsheet — a plain endpoint, not a secret key, so there is nothing
# to rotate and it can be swapped from the Vercel dashboard without a deploy.
# Setup steps live in the handoff document. While this is unset, /new-student
# tells students the form isn't connected and shows the ministry email instead
# of silently dropping a signup.
REGISTRATION_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
